# SpeakerDraft — Environment Variables
# Copie este arquivo para .env e preencha os valores necessários
# NUNCA commite o arquivo .env real (está no .gitignore)

# =============================================================================
# SUPABASE (Opcional — funciona em modo local sem estas variáveis)
# =============================================================================
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# =============================================================================
# STORAGE BACKEND
# =============================================================================
# 'local' (padrão) = IndexedDB no navegador
# 'supabase' = Supabase Postgres + Storage (requer variáveis acima)
# VITE_STORAGE_BACKEND=local

# =============================================================================
# BIBLE CONFIGURATION
# =============================================================================
# Tradução bíblica padrão (código do adapter registrado em core)
# Opções disponíveis: 'WEB_PT' (padrão, domínio público)
# VITE_DEFAULT_BIBLE_VERSION=WEB_PT

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Nome da aplicação (usado em títulos, meta tags)
# VITE_APP_NAME=SpeakerDraft

# URL base para deep links (produção)
# VITE_APP_URL=https://speakerdraft.app

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Habilitar modo de desenvolvimento/debug
# VITE_DEV_MODE=false

# Habilitar logs de debug do TanStack Query
# VITE_QUERY_DEBUG=false

# =============================================================================
# ANALYTICS (Opcional)
# =============================================================================
# Google Analytics Measurement ID
# VITE_GA_MEASUREMENT_ID=

# =============================================================================
# EXAMPLE: Configuração completa para Supabase
# =============================================================================
# VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# VITE_STORAGE_BACKEND=supabase
# VITE_DEFAULT_BIBLE_VERSION=WEB_PT
# VITE_APP_NAME=SpeakerDraft
# VITE_APP_URL=https://speakerdraft.app
# VITE_DEV_MODE=false